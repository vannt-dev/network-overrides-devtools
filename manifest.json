{
    "manifest_version": 3,
    "name": "Network Overrides (DevTools)",
    "version": "1.0",
    "description": "Add response body overrides from a DevTools panel using the Debugger Protocol.",
    "permissions": [
        "storage",
        "debugger"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon-16x16.png"
        }
    },
    "icons": {
        "16": "icons/icon-16x16.png",
        "48": "icons/icon-48x48.png",
        "128": "icons/icon-128x128.png"
    }
}