{
  "name": "network-overrides-devtools",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test tests/*.test.mjs",
    "coverage": "npm run build && c8 --reporter=text --reporter=lcov --reporter=html --report-dir coverage node --test tests/*.test.mjs",
    "ci:test": "npm run coverage",
    "package:store": "npm run build && node scripts/package-store.mjs",
    "prepare": "husky"
  },
  "c8": {
    "all": true,
    "exclude": [
      "tests/**/*.mjs"
    ],
    "include": [
      "dist/**/*.js"
    ],
    "report-dir": "coverage"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.178",
    "c8": "^11.0.0",
    "jsdom": "^29.0.1",
    "typescript": "^5.5.0",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "husky": "^9.1.5",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3"
  }
}
