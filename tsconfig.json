{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["DOM", "ES2020"],
    "strict": true,
    "noImplicitAny": true,
    "outDir": "dist",
    "rootDir": "src",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "sourceMap": true,
    "types": ["chrome"]
  },
  "include": ["src/**/*"]
}
